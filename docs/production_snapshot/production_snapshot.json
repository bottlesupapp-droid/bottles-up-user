   "roles": "{authenticated}",
   "using": "is_admin()",
   "check": "is_admin()"
  },
  {
   "table": "promo_codes",
   "name": "promo_codes: admin full access",
   "cmd": "ALL",
   "roles": "{public}",
   "using": "is_cms_admin()",
   "check": "is_cms_admin()"
  },
  {
   "table": "site_bottles",
   "name": "admins manage bottles",
   "cmd": "ALL",
   "roles": "{public}",
   "using": "is_cms_admin()",
   "check": "is_cms_admin()"
  },
  {
   "table": "site_bottles",
   "name": "public read available bottles for published venues",
   "cmd": "SELECT",
   "roles": "{public}",
   "using": "(is_cms_admin() OR (is_available AND (NOT is_sold_out) AND (EXISTS ( SELECT 1 FROM site_venues v WHERE ((v.id = site_bottles.venue_id) AND (v.status = 'published'::text))))))",
   "check": ""
  },
  {
   "table": "site_content",
   "name": "admins update site content",
   "cmd": "UPDATE",
   "roles": "{public}",
   "using": "is_cms_admin()",
   "check": "is_cms_admin()"
  },
  {
   "table": "site_content",
   "name": "public read site content",
   "cmd": "SELECT",
   "roles": "{public}",
   "using": "true",
   "check": ""
  },
  {
   "table": "site_events",
   "name": "admins manage events",
