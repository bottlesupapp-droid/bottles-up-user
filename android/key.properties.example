# Android release signing. Copy this file to key.properties and fill in the real values.
# key.properties is gitignored: never commit it, and back the keystore up (losing it means losing the ability to update the app).

# Path to your keystore file (relative to the android/ folder)
storeFile=upload-keystore.jks

# Keystore password
storePassword=YOUR_STORE_PASSWORD_HERE

# Key alias
keyAlias=upload

# Key password
keyPassword=YOUR_KEY_PASSWORD_HERE

# To generate a keystore:
# keytool -genkey -v -keystore android/upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
